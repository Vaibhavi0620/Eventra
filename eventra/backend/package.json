{
  "name": "eventra-backend",
  "version": "1.0.0",
  "description": "EVENTRA AI-Assisted NFT Ticketing and Anti-Scalping System Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=./schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./schema.prisma --name init_eventra",
    "prisma:push": "prisma db push --schema=./schema.prisma",
    "seed": "tsx src/seedRunner.ts",
    "event-image": "tsx src/scripts/setEventImage.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mysten/sui": "^1.14.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
